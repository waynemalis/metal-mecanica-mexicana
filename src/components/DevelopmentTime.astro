---
import illustration from "../assets/illustration.webp"
import { useTranslations } from "../i18n/utils";
import { languageList } from "../i18n/ui";

const currentLocale = (Astro.currentLocale || 'es') as keyof typeof languageList;
const t = useTranslations(currentLocale);
---

<section id="DevelopmentTime" class="w-full bg-[#1E3F20] py-24 md:py-36 flex justify-center items-center px-6 mt-24 overflow-hidden relative select-none border-y border-white/5 shadow-inner">
    <!-- Ruido texturizado premium para mayor profundidad -->
    <!-- Luces difusas de ambiente -->
    <div class="absolute left-[-15%] top-[-25%] w-[450px] h-[450px] bg-[#A3E034]/10 rounded-full blur-[110px] pointer-events-none -z-8"></div>
    <div class="absolute right-[-15%] bottom-[-25%] w-[450px] h-[450px] bg-black/45 rounded-full blur-[110px] pointer-events-none -z-8"></div>

    <div class="max-w-5xl mx-auto text-center relative z-10 flex flex-col gap-8 md:gap-10">
        <!-- Tag de Categoría de Diseño Fino -->
        <span class="dev-time-tag text-[10px] md:text-xs font-semibold text-[#A3E034] uppercase tracking-widest font-sans opacity-0 translate-y-3 block">
            {currentLocale === 'es' ? 'Tiempos de Ejecución' : 'Project Timeline'}
        </span>

        <div class="flex flex-col gap-6 md:gap-8 max-w-4xl mx-auto">
            <!-- Bloque 1 de Texto Grande Animado -->
            <h2 class="dev-time-title-1 text-3xl sm:text-5xl lg:text-6xl font-neuton font-medium italic text-white leading-tight opacity-0 translate-y-8">
                “<span set:html={t('devtime.text.1')}></span>”
            </h2>

            <!-- Bloque 2 de Texto Grande Destacado en Verde -->
            <h3 class="dev-time-title-2 text-2xl sm:text-4xl lg:text-5xl font-neuton font-light italic text-[#A3E034] leading-relaxed opacity-0 translate-y-6">
                {t('devtime.text.2')}
            </h3>
        </div>
        
        <!-- Línea Separadora Gráfica -->
        <div class="dev-time-line w-20 h-[1.5px] bg-[#A3E034]/35 mx-auto opacity-0 scale-x-0 transition-transform"></div>
    </div>

    <img src={illustration.src} class="absolute translate-y-[20%] left-1/2 -translate-x-1/2 w-full md:w-[80%] h-full object-cover opacity-50 pointer-events-none z-1" alt="">
</section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Animación premium con timeline coordinada por ScrollTrigger
    const tl = gsap.timeline({
        scrollTrigger: {
            trigger: '#DevelopmentTime',
            start: 'top 80%', // Inicia cuando la parte superior de la sección entra al 80% de la ventana
            toggleActions: 'restart none none reset' // Se reproduce de nuevo al volver a verla
        }
    });

    // 1. Entrada del tag
    tl.to('.dev-time-tag', {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power3.out'
    });

    // 2. Revelado del primer bloque de texto
    tl.to('.dev-time-title-1', {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out'
    }, '-=0.35');

    // 3. Spin 3D tipo ruleta para los números de semanas
    const buildDrum = (host: Element) => {
        const target = parseInt(host.getAttribute('data-target') || '0', 10);
        const digits = String(target).split('');

        if (!(host as HTMLElement).dataset.built) {
            (host as HTMLElement).dataset.built = '1';
            (host as HTMLElement).style.cssText = `
                display: inline-block;
                position: relative;
                top: 0.12em;
                overflow: hidden;
                height: 1.05em;
                width: auto;
                mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
                -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
            `;

            digits.forEach((digit: string) => {
                const drumWrap = document.createElement('span');
                drumWrap.className = 'drum-wrap';
                drumWrap.style.cssText = `
                    display: inline-flex;
                    position: relative;
                    height: 1.05em;
                    width: 0.62em;
                    overflow: hidden;
                `;

                const strip = document.createElement('span');
                strip.className = 'drum-strip';
                strip.style.cssText = `
                    display: flex;
                    flex-direction: column;
                    will-change: transform;
                `;

                const totalSlots = 10 + parseInt(digit, 10) + 1;
                for (let i = 0; i < totalSlots; i++) {
                    const slot = document.createElement('span');
                    slot.style.cssText = `display: block; height: 1.05em; line-height: 1.05em; text-align: center; flex-shrink: 0;`;
                    slot.textContent = String(i % 10);
                    strip.appendChild(slot);
                }

                drumWrap.appendChild(strip);
                host.appendChild(drumWrap);
            });
        }
    };

    const spinDrums = (host: Element) => {
        const target = parseInt(host.getAttribute('data-target') || '0', 10);
        host.querySelectorAll('.drum-strip').forEach((strip: Element, i: number) => {
            const digitVal = parseInt(String(target).split('')[i] || '0', 10);
            const totalSlots = 10 + digitVal + 1;
            const targetOffset = -(totalSlots - 1) * 1.05;

            gsap.fromTo(strip,
                { y: '0em' },
                {
                    y: `${targetOffset}em`,
                    duration: 1.4 + i * 0.15,
                    ease: 'power3.out',
                    delay: 0.3 + i * 0.08
                }
            );
        });
    };

    // Construir los drums al cargar la página
    document.querySelectorAll('.devtime-number').forEach(buildDrum);

    // Conectar al ScrollTrigger — se reproduce cada vez que vuelve a verse
    ScrollTrigger.create({
        trigger: '#DevelopmentTime',
        start: 'top 85%',
        onEnter: () => document.querySelectorAll('.devtime-number').forEach(spinDrums),
        onEnterBack: () => document.querySelectorAll('.devtime-number').forEach(spinDrums)
    });

    // 4. Revelado del segundo bloque de texto
    tl.to('.dev-time-title-2', {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out'
    }, '-=0.65');

    // 5. Crecimiento de la línea gráfica
    tl.to('.dev-time-line', {
        opacity: 1,
        scaleX: 1,
        duration: 0.8,
        ease: 'power2.out'
    }, '-=0.55');
</script>
