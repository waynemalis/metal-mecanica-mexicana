---
import { useTranslations } from "../i18n/utils";
import { languageList } from "../i18n/ui";

const currentLocale = (Astro.currentLocale || 'es') as keyof typeof languageList;
const t = useTranslations(currentLocale);
---

<div id="Career" class="career-card w-full flex justify-center px-10 md:px-20 py-12 md:py-34">
    <span class="max-w-full md:max-w-4xl text-center text-black text-3xl md:text-4xl font-neuton font-light italic">"<span set:html={t('career.title')}></span>"</span>
</div>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Animación de entrada con scroll unidireccional (scrub que no retrocede salvo que salga de pantalla por abajo)
    gsap.utils.toArray('.career-card').forEach((card: any) => {
        const anim = gsap.from(card, {
            scale: 0.85,
            opacity: 0,
            y: 80,
            paused: true,
        });

        let maxProgress = 0;

        ScrollTrigger.create({
            trigger: card,
            start: 'top 95%', // Inicia al entrar por la parte inferior de la pantalla
            end: 'top 65%',   // Finaliza al subir un 30% del viewport
            onUpdate: (self) => {
                // Solo avanzamos la animación si el scroll actual supera el progreso máximo alcanzado
                if (self.progress > maxProgress) {
                    maxProgress = self.progress;
                    gsap.to(anim, { progress: maxProgress, duration: 0.3, overwrite: 'auto' });
                }
            },
            onLeaveBack: () => {
                // Cuando el usuario hace scroll hacia arriba y la tarjeta sale por completo de la pantalla por abajo,
                // reiniciamos el progreso para que pueda volver a animarse en la siguiente bajada.
                maxProgress = 0;
                gsap.set(anim, { progress: 0 });
            }
        });

        // Spin 3D tipo ruleta — se ejecuta al entrar y al volver a ver la sección
        const numbers = card.querySelectorAll('.career-number');
        numbers.forEach((host: any) => {
            const target = parseInt(host.getAttribute('data-target') || '0', 10);
            const digits = String(target).split('');

            // Construir el DOM del drum sólo la primera vez
            if (!host.dataset.built) {
                host.dataset.built = '1';
                // Contendor del drum: inline-flex, altura de 1 línea, overflow hidden + perspective
                host.style.cssText = `
                    display: inline-block;
                    position: relative;
                    top: 0.12em;
                    overflow: hidden;
                    height: 1.05em;
                    width: auto;
                    mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
                    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
                `;

                digits.forEach((digit: string) => {
                    const drumWrap = document.createElement('span');
                    drumWrap.className = 'drum-wrap';
                    drumWrap.style.cssText = `
                        display: inline-flex;
                        position: relative;
                        height: 1.05em;
                        width: 0.62em;
                        overflow: hidden;
                    `;

                    // Crear una tira de 0 a target+1 para la ilusión del giro
                    const strip = document.createElement('span');
                    strip.className = 'drum-strip';
                    strip.style.cssText = `
                        display: flex;
                        flex-direction: column;
                        will-change: transform;
                        transform-origin: center;
                    `;

                    // La tira comienza con varios dígitos "de carrera" desde 0 hasta el destino
                    const totalSlots = 10 + parseInt(digit, 10) + 1; // vuelta extra de 0-9 + llegar al destino
                    for (let i = 0; i < totalSlots; i++) {
                        const slot = document.createElement('span');
                        slot.style.cssText = `display: block; height: 1.05em; line-height: 1.05em; text-align: center; flex-shrink: 0;`;
                        slot.textContent = String(i % 10);
                        strip.appendChild(slot);
                    }

                    drumWrap.appendChild(strip);
                    host.appendChild(drumWrap);
                });
            }

            const spinDrum = () => {
                host.querySelectorAll('.drum-strip').forEach((strip: any, i: number) => {
                    const digitVal = parseInt(String(target).split('')[i] || '0', 10);
                    const totalSlots = 10 + digitVal + 1;
                    const targetOffset = -(totalSlots - 1) * 1.05; // en em

                    gsap.fromTo(strip,
                        { y: '0em' },
                        {
                            y: `${targetOffset}em`,
                            duration: 1.4 + i * 0.15,
                            ease: 'power3.out',
                            delay: i * 0.06
                        }
                    );
                });
            };

            ScrollTrigger.create({
                trigger: card,
                start: 'top 90%',
                onEnter: spinDrum,
                onEnterBack: spinDrum
            });
        });
    });
</script>