---
import image from '../assets/us.webp';
import { ChevronDown, Pause, Play } from '@lucide/astro'

import { useTranslations } from "../i18n/utils";
import { languageList } from "../i18n/ui";

const currentLocale = (Astro.currentLocale || 'es') as keyof typeof languageList;
const t = useTranslations(currentLocale);
---

<div id="Difference" class="w-full h-[60vh] flex items-center justify-center">
    <div class="relative w-[90vw] h-full mx-auto overflow-hidden rounded-[16px] flex flex-col items-center justify-center text-center p-6 md:p-12">
        <!-- Contenido de Texto sobre la Imagen (Adaptado a móviles con max-w-[90%]) -->
        <div id="difference-content" class="max-w-[90%] md:max-w-[55%] px-4 z-10 text-white flex flex-col items-center">
            <h2 id="difference-text" class="text-xl md:text-3xl italic text-white mb-4 md:mb-6 select-none">{t('difference.text')}</h2>
            <a href="#Contacto" id="difference-btn" class="px-6 py-3 rounded-full bg-white text-black mt-6 md:mt-8 hover:bg-[#A3E034] transition-all duration-300 cursor-pointer inline-block text-center">{t('difference.contactus')}</a>
        </div>

        <img src={image.src} class="w-full h-full object-cover absolute top-0 left-0 -z-10" alt="" />
        <div class="w-full h-full bg-gradient-to-t from-[#A3E034]/30 via-[#A3E034]/10 to-transparent absolute top-0 left-0 -z-8"></div>
        <div class="w-full h-full bg-black/80 absolute top-0 left-0 -z-9"></div>
    </div>
</div>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const isMobile = window.innerWidth < 768;

    // Animación de entrada con scroll unidireccional y revelación interna (parallax)
    gsap.utils.toArray('#Difference').forEach((card: any) => {
        // Timeline para coordinar la tarjeta y sus textos internos
        const tl = gsap.timeline({ paused: true });

        // 1. Entrada de la tarjeta
        tl.from(card, {
            scale: 0.9,
            opacity: 0,
            y: isMobile ? 60 : 120, // yOffset adaptado a móvil para evitar saltos bruscos
            ease: 'power2.out',
            duration: 1,
        }, 0);

        // 2. Parallax de textos (se desplazan ligeramente después)
        tl.from('#difference-text', {
            opacity: 0,
            y: 25,
            ease: 'power2.out',
            duration: 0.8,
        }, 0.25);

        let maxProgress = 0;

        ScrollTrigger.create({
            trigger: card,
            start: isMobile ? 'top 95%' : 'top 105%', // Inicia antes en móvil para fluidez
            end: isMobile ? 'top 45%' : 'top 35%',
            onUpdate: (self) => {
                // Avanza la timeline sólo al bajar
                if (self.progress > maxProgress) {
                    maxProgress = self.progress;
                    gsap.to(tl, { progress: maxProgress, duration: 0.3, overwrite: 'auto' });
                }
            },
            onLeaveBack: () => {
                // Reinicia al salir por abajo
                maxProgress = 0;
                gsap.set(tl, { progress: 0 });
            }
        });
    });
</script>