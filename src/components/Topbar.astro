---
import siteLogo from "../assets/logo.png";
import { Globe, Menu } from '@lucide/astro'

import { useTranslations } from "../i18n/utils";
import { languageList } from "../i18n/ui";

const currentLocale = (Astro.currentLocale || 'es') as keyof typeof languageList;
const t = useTranslations(currentLocale);
---

<nav id="topbar" class="fixed w-full flex justify-center p-2 z-99 border-b border-transparent">
    <div class="w-[95%] md:w-[90%] flex justify-between items-center">
        <a href="/"><img id="topbar-logo" src={siteLogo.src} class="invert" width="120" height="auto" alt="Logo" /></a>
        
        <!-- Navegación Escritorio (Links reales a las secciones) -->
        <div class="hidden md:flex items-center space-x-3 text-lg">
            <a href="#Hero" class="nav-text-white text-white px-4 py-1.5 rounded-full hover:bg-white/10 cursor-pointer transition-colors duration-300 text-sm font-sans">{t('nav.home') || 'Inicio'}</a>
            <a href="#Us" class="nav-text-white text-white px-4 py-1.5 rounded-full hover:bg-white/10 cursor-pointer transition-colors duration-300 text-sm font-sans">{t('nav.about') || 'Nosotros'}</a>
            <a href="#Quality" class="nav-text-white text-white px-4 py-1.5 rounded-full hover:bg-white/10 cursor-pointer transition-colors duration-300 text-sm font-sans">{t('quality.title') || 'Calidad'}</a>
            <a href="#Contacto" class="text-black px-5 py-2 rounded-full bg-[#A3E034] hover:bg-[#A3E034]/80 cursor-pointer transition-colors duration-300 text-sm font-sans">Contacto</a>
            
            <!-- Selector de Idioma (Dropdown Animado Elegante) -->
            <div class="relative inline-block text-left" id="lang-dropdown-wrapper">
                <button id="lang-dropdown-btn" class="text-white px-5 py-2 rounded-full bg-[#132D0B] hover:bg-[#132D0B]/80 cursor-pointer transition-colors duration-300 flex items-center space-x-2 select-none text-sm font-sans">
                    <Globe size={16} />
                    <span class="uppercase">{currentLocale}</span>
                </button>
                <!-- Menú Desplegable (Con transición y sombra) -->
                <div id="lang-dropdown-menu" class="absolute right-0 mt-2 w-36 rounded-xl bg-white border border-slate-100 shadow-xl overflow-hidden pointer-events-none opacity-0 scale-95 origin-top-right transition-all duration-200 z-50">
                    <div class="py-1">
                        <a href="/" class="flex items-center px-4 py-2.5 text-xs text-slate-800 hover:bg-[#A3E034]/15 transition-colors font-sans font-medium">{t('lang.es')}</a>
                        <a href="/en/" class="flex items-center px-4 py-2.5 text-xs text-slate-800 hover:bg-[#A3E034]/15 transition-colors font-sans font-medium">{t('lang.en')}</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botón Menú Móvil -->
        <button id="mobile-menu-btn" class="nav-text-white flex items-center md:hidden text-white p-2 rounded-lg cursor-pointer transition-colors duration-300">
            <Menu size={32} />
        </button>
    </div>
</nav>

<!-- Overlay de Menú Móvil (Pantalla Completa Animado con GSAP) -->
<div id="mobile-menu-overlay" class="fixed inset-0 w-full h-[100vh] bg-[#1E3F20]/98 backdrop-blur-md z-999 flex flex-col justify-between p-8 pointer-events-none opacity-0">
    <!-- Header del Menú Móvil -->
    <div class="flex justify-between items-center w-full">
        <img src={siteLogo.src} class="invert" width="105" height="auto" alt="Logo" />
        <button id="mobile-menu-close-btn" class="text-white p-2 cursor-pointer hover:bg-white/10 rounded-full transition-colors duration-300">
            <!-- Icono X de Lucide -->
            <svg class="w-8 h-8 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <!-- Enlaces de Navegación del Móvil -->
    <div class="flex flex-col gap-6 text-center my-auto">
        <a href="#Hero" class="mobile-nav-link text-white text-2xl font-neuton italic tracking-wider hover:text-[#A3E034] transition-colors">{t('nav.home') || 'Inicio'}</a>
        <a href="#Us" class="mobile-nav-link text-white text-2xl font-neuton italic tracking-wider hover:text-[#A3E034] transition-colors">{t('nav.about') || 'Nosotros'}</a>
        <a href="#Quality" class="mobile-nav-link text-white text-2xl font-neuton italic tracking-wider hover:text-[#A3E034] transition-colors">{t('quality.title') || 'Calidad'}</a>
        <a href="#Contacto" class="mobile-nav-link text-white text-2xl font-neuton italic tracking-wider hover:text-[#A3E034] transition-colors">{t('nav.contact') || 'Contacto'}</a>
    </div>

    <!-- Pie del Menú Móvil: Selección de Idioma -->
    <div class="flex flex-col items-center gap-4 w-full">
        <span class="text-xs text-white/50 tracking-widest font-sans uppercase">Language</span>
        <div class="flex gap-4">
            <a href="/" class={`px-5 py-2 rounded-full flex items-center space-x-2 text-sm select-none ${currentLocale === 'es' ? 'text-black bg-[#A3E034] shadow-[0_0_15px_rgba(163,224,52,0.2)]' : 'text-white bg-white/10 hover:bg-white/20'}`}>
                <Globe size={16} />
                <span>{t('lang.es')}</span>
            </a>
            <a href="/en/" class={`px-5 py-2 rounded-full flex items-center space-x-2 text-sm select-none ${currentLocale === 'en' ? 'text-black bg-[#A3E034] shadow-[0_0_15px_rgba(163,224,52,0.2)]' : 'text-white bg-white/10 hover:bg-white/20'}`}>
                <Globe size={16} />
                <span>{t('lang.en')}</span>
            </a>
        </div>
    </div>
</div>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // --- 1. LÓGICA DEL DROPDOWN DE IDIOMA EN ESCRITORIO ---
    const dropdownBtn = document.getElementById('lang-dropdown-btn');
    const dropdownMenu = document.getElementById('lang-dropdown-menu');
    const dropdownWrapper = document.getElementById('lang-dropdown-wrapper');

    if (dropdownBtn && dropdownMenu) {
        dropdownBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = dropdownMenu.classList.contains('opacity-100');
            if (isOpen) {
                closeDropdown();
            } else {
                openDropdown();
            }
        });
    }

    function openDropdown() {
        if (dropdownMenu) {
            dropdownMenu.classList.remove('pointer-events-none', 'opacity-0', 'scale-95');
            dropdownMenu.classList.add('pointer-events-auto', 'opacity-100', 'scale-100');
        }
    }

    function closeDropdown() {
        if (dropdownMenu) {
            dropdownMenu.classList.remove('pointer-events-auto', 'opacity-100', 'scale-100');
            dropdownMenu.classList.add('pointer-events-none', 'opacity-0', 'scale-95');
        }
    }

    // Cerrar al hacer click fuera
    window.addEventListener('click', (e) => {
        if (dropdownWrapper && !dropdownWrapper.contains(e.target as Node)) {
            closeDropdown();
        }
    });

    // --- 2. LÓGICA DEL MENÚ MÓVIL (ANIMADO CON GSAP) ---
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileCloseBtn = document.getElementById('mobile-menu-close-btn');
    const mobileOverlay = document.getElementById('mobile-menu-overlay');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    if (mobileBtn && mobileOverlay && mobileCloseBtn) {
        // Abrir Menú Móvil
        mobileBtn.addEventListener('click', () => {
            mobileOverlay.classList.remove('pointer-events-none');
            mobileOverlay.classList.add('pointer-events-auto');

            gsap.killTweensOf([mobileOverlay, '.mobile-nav-link']);
            
            // Animación de entrada
            gsap.to(mobileOverlay, {
                opacity: 1,
                duration: 0.4,
                ease: 'power2.out',
            });

            gsap.fromTo('.mobile-nav-link', {
                opacity: 0,
                y: 20,
            }, {
                opacity: 1,
                y: 0,
                stagger: 0.08,
                duration: 0.4,
                ease: 'power2.out',
                delay: 0.15,
            });
        });

        // Cerrar Menú Móvil
        const closeMobileMenu = () => {
            mobileOverlay.classList.remove('pointer-events-auto');
            mobileOverlay.classList.add('pointer-events-none');

            gsap.killTweensOf([mobileOverlay, '.mobile-nav-link']);

            gsap.to(mobileOverlay, {
                opacity: 0,
                duration: 0.3,
                ease: 'power2.in',
            });
        };

        mobileCloseBtn.addEventListener('click', closeMobileMenu);
        
        // Cerrar al clickar cualquier enlace
        mobileLinks.forEach(link => {
            link.addEventListener('click', closeMobileMenu);
        });
    }

    // --- 3. ANIMACIONES EN SCROLL DE LA TOPBAR (YA EXISTENTES) ---
    gsap.set('#topbar', {
        backgroundColor: 'rgba(255, 255, 255, 0)',
        borderBottomColor: 'rgba(255, 255, 255, 0)'
    });

    const tl = gsap.timeline({
        scrollTrigger: {
            trigger: '#Hero',
            start: 'bottom top',
            end: '+=100',
            scrub: true,
        }
    });

    tl.to('#topbar', {
        backgroundColor: 'rgba(255, 255, 255, 0.9)',
        backdropFilter: 'blur(12px)',
        borderBottomColor: 'rgba(0, 0, 0, 0.08)',
        ease: 'power1.inOut',
    }, 0);

    tl.to('#topbar-logo', {
        filter: 'invert(0)',
        ease: 'power1.inOut',
        scrollTrigger: {
            trigger: '#Hero',
            start: 'top top',
            end: 'bottom 40%',
            scrub: true,
        }
    }, 0);

    tl.to('.nav-text-white', {
        filter: 'invert(1)',
        ease: 'power1.inOut',
        scrollTrigger: {
            trigger: '#Hero',
            start: 'top top',
            end: 'bottom 40%',
            scrub: true,
        }
    }, 0);
</script>
