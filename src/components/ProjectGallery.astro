---
import image1 from '../assets/images/1.jpg';
import image2 from '../assets/images/3.jpg';
import image3 from '../assets/images/9.jpg';
import image4 from '../assets/images/10.jpg';
import image5 from '../assets/images/4.jpg';
import image6 from '../assets/images/8.jpg';

import { useTranslations } from "../i18n/utils";
import { languageList } from "../i18n/ui";

const currentLocale = (Astro.currentLocale || 'es') as keyof typeof languageList;
const t = useTranslations(currentLocale);

// Proyectos — reemplaza `bg` y `img` cuando las fotos estén listas
const projects = [
    { id: 1, label: currentLocale === 'es' ? 'Línea de Clasificación' : 'Grading Line',      bg: '#1E3F20' , img: image1.src},
    { id: 2, label: currentLocale === 'es' ? 'Sistema de Lavado'      : 'Washing System',     bg: '#1B2719' , img: image2.src},
    { id: 3, label: currentLocale === 'es' ? 'Transportador de Canastas' : 'Basket Conveyor', bg: '#253D22' , img: image3.src},
    { id: 4, label: currentLocale === 'es' ? 'Mesa de Inspección'     : 'Inspection Table',   bg: '#1E3F20' , img: image4.src},
    { id: 5, label: currentLocale === 'es' ? 'Empacadora Automática'  : 'Auto Packing Line',  bg: '#1B2719' , img: image5.src},
    { id: 6, label: currentLocale === 'es' ? 'Línea de Embolsado'     : 'Bagging Line',       bg: '#253D22' , img: image6.src},
];
---

<section id="ProjectGallery" class="relative overflow-hidden">

    <!-- Header estático encima del scroll -->
    <div class="gallery-header w-full pt-32 md:pt-40 pb-10 px-6 overflow-hidden">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-end justify-between gap-6">
            <div class="ws-header flex flex-col gap-4 max-w-2xl">
                <span class="text-[10px] md:text-xs font-sans font-semibold uppercase tracking-widest text-white bg-[#1E3F20] px-5 py-3 rounded-full inline-block w-fit">
                    {t('gallery.tag')}
                </span>
                <h2 class="font-neuton font-light text-4xl md:text-6xl text-[#1B2719] leading-tight">
                    {t('gallery.title')}<br/>
                    <em class="italic">{t('gallery.subtitle')}</em>
                </h2>
            </div>

            <!-- Hint de drag -->
            <div class="gallery-drag-hint flex items-center gap-3 text-[#4E584B]/60 text-sm font-sans select-none pb-1">
                <svg width="32" height="18" viewBox="0 0 32 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2 9H30M24 3L30 9L24 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M30 9H2M8 3L2 9L8 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.4"/>
                </svg>
                {t('gallery.drag')}
            </div>
        </div>
    </div>

    <!-- Panel de scroll horizontal: SOLO esto se pinea, el header de arriba no -->
    <div id="gallery-pin" class="relative w-full overflow-hidden">
        <div id="gallery-track" class="flex gap-5 px-8 md:px-16 py-10 will-change-transform">
            {projects.map((proj) => (
                <div
                    class="gallery-card flex-shrink-0 w-[80vw] sm:w-[55vw] md:w-[42vw] lg:w-[34vw] xl:w-[28vw] h-[62vh] md:h-[68vh] max-h-[620px] rounded-2xl overflow-hidden relative group cursor-grab active:cursor-grabbing"
                    style={`background-color: ${proj.bg};`}
                    data-id={proj.id}
                >
                    <!-- Info inferior -->
                    <div class="absolute inset-0 flex items-end p-6 md:p-8 pr-10 z-10">
                        <div class="relative z-10 flex flex-col gap-2 w-full">
                            <div class="w-6 h-[1.5px] rounded-full bg-white/80"></div>
                            <span class="text-white/60 font-sans text-xs tracking-widest uppercase">
                                {`0${proj.id}`}
                            </span>
                        </div>
                    </div>
                    <img src={proj.img} alt="" class="absolute inset-0 w-full h-full object-cover" />

                    <!-- Overlay hover sutil -->
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/15 transition-all duration-500 pointer-events-none"></div>
                </div>
            ))}
            <div class="hidden md:flex flex-shrink-0 w-[5vw] h-[62vh] md:h-[68vh] max-h-[620px] rounded-2xl overflow-hidden relative group cursor-grab active:cursor-grabbing"></div>
        </div>
    </div>
</section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { Observer } from 'gsap/Observer';

    gsap.registerPlugin(ScrollTrigger, Observer);

    const track = document.getElementById('gallery-track');
    const pinWrap = document.getElementById('gallery-pin');
    const section = document.getElementById('ProjectGallery');

    // Altura real del nav fijo (ajusta el selector si tu nav no es <header>/<nav>)
    const navEl = document.querySelector('header, nav') as HTMLElement | null;
    const getNavOffset = () => (navEl ? navEl.getBoundingClientRect().height : 0);

    if (track && pinWrap && section) {
        let scrollLength = 0;
        const refresh = () => {
            scrollLength = track.scrollWidth - window.innerWidth;
        };
        refresh();

        // Scroll horizontal con pin mientras el usuario hace scroll vertical
        const mm = gsap.matchMedia();

        mm.add('(min-width: 768px)', () => {
            // Desktop: el header hace scroll normal; SOLO #gallery-pin se fija y hace scroll horizontal
            const tween = gsap.to(track, {
                x: () => -scrollLength,
                ease: 'none',
                scrollTrigger: {
                    trigger: pinWrap,
                    pin: pinWrap,
                    start: () => `top ${getNavOffset()}`,
                    end: () => `+=${scrollLength}`,
                    scrub: 1,
                    invalidateOnRefresh: true,
                }
            });

            ScrollTrigger.addEventListener('refreshInit', refresh);

            return () => {
                ScrollTrigger.removeEventListener('refreshInit', refresh);
                tween.kill();
            };
        });

        mm.add('(max-width: 767px)', () => {
            // Móvil: drag nativo habilitado con overflow-x
            pinWrap.style.overflowX = 'auto';
            pinWrap.style.scrollSnapType = 'x mandatory';
            pinWrap.style.WebkitOverflowScrolling = 'touch';
            track.querySelectorAll<HTMLElement>('.gallery-card').forEach(card => {
                card.style.scrollSnapAlign = 'start';
            });
        });

        // Entrada del header con fade
        gsap.from('.gallery-header', {
            opacity: 0,
            y: 30,
            duration: 0.9,
            ease: 'power3.out',
            scrollTrigger: {
                trigger: section,
                start: 'top 85%',
                toggleActions: 'play none none none'
            }
        });

        // Hint de drag que desaparece al empezar el scroll
        const dragHint = document.querySelector('.gallery-drag-hint') as HTMLElement;
        if (dragHint) {
            ScrollTrigger.create({
                trigger: section,
                start: 'top 60%',
                onEnter: () => gsap.to(dragHint, { opacity: 0, x: 12, duration: 0.4, ease: 'power2.in' }),
                onLeaveBack: () => gsap.to(dragHint, { opacity: 1, x: 0, duration: 0.4, ease: 'power2.out' })
            });
        }
    }
</script>