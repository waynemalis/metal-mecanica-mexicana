---
import image from '../assets/us.webp';
import { ChevronDown, Pause, Play } from '@lucide/astro'

import { useTranslations } from "../i18n/utils";
import { languageList } from "../i18n/ui";

const currentLocale = (Astro.currentLocale || 'es') as keyof typeof languageList;
const t = useTranslations(currentLocale);
---

<div id="Us" class="w-full">
    <!-- Versión Escritorio -->
    <div id="Us-desktop" class="hidden md:flex relative w-full h-[100vh] overflow-hidden">
        <div class="relative w-full h-full flex items-center justify-end px-[5%] md:px-[8%]">
            <!-- Contenedor de Media (Imagen + Máscara) que se encogerá y moverá a la izquierda -->
            <div id="us-media" class="absolute w-full h-full top-0 left-0 overflow-hidden origin-center">
                <img src={image.src} class="w-full h-full object-cover" alt="Nosotros" />
            </div>

            <!-- Bloque de Texto (colocado a la derecha) -->
            <div id="us-content" class="w-full md:w-[40%] flex flex-col gap-6 text-left z-10 pointer-events-none">
                <h2 class="text-3xl md:text-5xl font-neuton font-medium italic text-[#1E3F20]">{t('us.title')}</h2>
                <p class="text-[#1B2719] text-base md:text-lg leading-relaxed opacity-90 text-justify">{t('us.text')}</p>
            </div>
        </div>
    </div>

    <!-- Versión Móvil -->
    <div id="Us-mobile" class="md:hidden w-full h-[50vh] flex flex-col relative items-center justify-center px-6 text-center overflow-hidden">
        <h2 class="text-3xl font-neuton font-medium italic text-[#A3E034] mb-4 z-10">{t('us.title')}</h2>
        <p class="text-white text-base md:text-lg leading-relaxed opacity-90 z-10">
            {t('us.text')}
        </p>
        <img src={image.src} class="absolute top-0 left-0 w-full h-full object-cover -z-10" alt="Nosotros" />
        <div class="w-full h-full bg-black/80 absolute top-0 left-0 -z-9"></div>
    </div>
</div>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Timeline para la animación de pinning de la sección "Nosotros" en escritorio
    const tl = gsap.timeline({
        scrollTrigger: {
            trigger: '#Us-desktop',
            start: 'top top',    // Se ancla al llegar al tope de la pantalla
            end: '+=1200',       // El scroll se congela durante 1200px de avance
            pin: true,           // Ancla el contenedor en el viewport
            scrub: true,         // Vincula el progreso de ida y vuelta al scroll
        }
    });

    // 1. La imagen con su overlay se encoge y se mueve a la izquierda
    tl.fromTo('#us-media', {
        width: '100%',
        height: '100%',
        left: '0%',
        top: '0%',
        yPercent: 0,
        borderRadius: '0px',
    }, {
        width: '46%',
        height: '80%',
        left: '6%',
        top: '55.5%',
        yPercent: -50,
        borderRadius: '16px',
        ease: 'power1.inOut',
    }, 0);

    // 2. El bloque de texto aparece (fade-in) y se desliza desde la derecha hacia su posición final
    tl.fromTo('#us-content', {
        opacity: 0,
        x: 80,
    }, {
        opacity: 1,
        x: 0,
        ease: 'power1.inOut',
    }, 0.15); // Inicia un poco después para crear un desfase premium

    // Animación de entrada para versión móvil
    gsap.fromTo("#Us-mobile", {
        opacity: 0,
        scale: 0.9,
        borderRadius: '32px',
    }, {
        opacity: 1,
        scale: 1,
        borderRadius: '0px',
        scrollTrigger: {
            trigger: '#Us-mobile',
            start: 'top bottom',
            end: 'top 30%',
            scrub: true,
        }
    });
</script>